# Works, newest first, with the sources that assert the link
SELECT ?work (SAMPLE(?n) AS ?workLabel) (MAX(STR(?d)) AS ?date) (SAMPLE(?v) AS ?venue) (SAMPLE(?vn) AS ?venueLabel)
       (GROUP_CONCAT(DISTINCT ?src; separator=" ") AS ?sources) WHERE {
  GRAPH ?g { ?work schema:author <{{iri}}> }
  BIND(STRAFTER(STR(?g), "urn:koetai-reconciliator:source:") AS ?src)
  OPTIONAL { ?work schema:name ?n }
  OPTIONAL { ?work schema:datePublished ?d }
  OPTIONAL { ?work schema:isPartOf ?v OPTIONAL { ?v schema:name ?vn } }
} GROUP BY ?work ORDER BY DESC(?date) LIMIT 1000
