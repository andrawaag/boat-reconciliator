# Works by this author that have a DOI but that Wikidata does not link to the author (no P50 statement).
# Used by the "Works missing on Wikidata" panel (src/wikidata-works.js), not shown as a table.
SELECT ?work (SAMPLE(?t) AS ?title) (SAMPLE(?d) AS ?date) (GROUP_CONCAT(DISTINCT ?wt; separator=" ") AS ?workTypes)
       (GROUP_CONCAT(DISTINCT STR(?cls); separator=" ") AS ?classes) (SAMPLE(?v) AS ?venue) (SAMPLE(?issn) AS ?venueIssn)
       (GROUP_CONCAT(DISTINCT ?src; separator=" ") AS ?sources) WHERE {
  {
    SELECT DISTINCT ?work WHERE {
      ?work schema:author <{{iri}}> .
      FILTER(STRSTARTS(STR(?work), "https://doi.org/"))
      MINUS { GRAPH <urn:koetai-reconciliator:source:wikidata> { ?work schema:author ?anyone } }
    }
  }
  GRAPH ?g { ?work schema:name ?t }
  BIND(STRAFTER(STR(?g), "urn:koetai-reconciliator:source:") AS ?src)
  OPTIONAL { ?work schema:datePublished ?d }
  OPTIONAL { ?work kr:workType ?wt }
  OPTIONAL { ?work a ?cls }
  OPTIONAL { ?work schema:isPartOf ?v OPTIONAL { ?v schema:issn ?issn } }
} GROUP BY ?work
