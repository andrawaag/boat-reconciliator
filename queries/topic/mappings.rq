# Codes in other terminologies, from every source. A row with several source badges means the sources agree.
# "exact": stated as the same concept (an ontology's exact match, or a Wikidata external ID); "xref": a database cross-reference.
# "inOls" / "olsStatus": the code as EBI's Ontology Lookup Service has it (current, obsolete, not found); empty where OLS
# does not cover the vocabulary (ICD, OMIM, …).
SELECT (SAMPLE(?voc) AS ?vocabulary) ?code (SAMPLE(?c) AS ?codeLabel)
       (GROUP_CONCAT(DISTINCT ?rel; separator=", ") AS ?relation) (GROUP_CONCAT(DISTINCT ?src; separator=" ") AS ?sources)
       (SAMPLE(?olsName) AS ?inOls) (SAMPLE(?status) AS ?olsStatus) (SAMPLE(?replaced) AS ?replacedBy) WHERE {
  { GRAPH ?g { <{{iri}}> skos:exactMatch ?code } BIND("exact" AS ?rel) }
  UNION
  { GRAPH ?g { <{{iri}}> oboInOwl:hasDbXref ?code } BIND("xref" AS ?rel) }
  OPTIONAL { ?code kr:vocabulary ?voc }
  OPTIONAL { ?code kr:code ?c }
  OPTIONAL { GRAPH <urn:koetai-reconciliator:source:ols> { ?code kr:olsStatus ?status } }
  OPTIONAL { GRAPH <urn:koetai-reconciliator:source:ols> { ?code kr:olsName ?olsName } }
  OPTIONAL { GRAPH <urn:koetai-reconciliator:source:ols> { ?code obo:IAO_0100001 ?replaced } }
  BIND(STRAFTER(STR(?g), "urn:koetai-reconciliator:source:") AS ?src)
} GROUP BY ?code ORDER BY ?vocabulary ?codeLabel
