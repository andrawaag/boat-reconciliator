CONSTRUCT { ?work wdt:P50 ?a . ?a rdfs:label ?l ; wdt:P496 ?orcid . }
WHERE {
  { SELECT DISTINCT ?work WHERE { ?work wdt:{{link}} wd:{{q}} ; wdt:P577 ?pd } ORDER BY DESC(?pd) LIMIT 1000 }
  ?work wdt:P50 ?a .
  OPTIONAL { ?a rdfs:label ?l FILTER(LANG(?l) = "en") }
  OPTIONAL { ?a wdt:P496 ?orcid }
}
