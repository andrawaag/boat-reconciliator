CONSTRUCT { ?x rdfs:label ?l ; wdt:P236 ?issn . }
WHERE {
  { SELECT DISTINCT ?x WHERE { { SELECT DISTINCT ?work WHERE { ?work wdt:{{link}} wd:{{q}} ; wdt:P577 ?pd } ORDER BY DESC(?pd) LIMIT 1000 } ?work wdt:P1433|wdt:P921 ?x } }
  OPTIONAL { ?x rdfs:label ?l FILTER(LANG(?l) = "en") }
  OPTIONAL { ?x wdt:P236 ?issn }
}
