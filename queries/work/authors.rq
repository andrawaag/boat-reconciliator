# Authors, in Crossref order where known, with the sources that list them
SELECT ?author (SAMPLE(?n) AS ?authorLabel) (MIN(?pos) AS ?position) (GROUP_CONCAT(DISTINCT ?src; separator=" ") AS ?sources) WHERE {
  GRAPH ?g { <{{iri}}> schema:author ?author }
  BIND(STRAFTER(STR(?g), "urn:koetai-bibliography:source:") AS ?src)
  OPTIONAL { ?author schema:name ?n }
  OPTIONAL { <{{iri}}> kb:authorship ?as . ?as kb:agent ?author ; kb:position ?pos }
} GROUP BY ?author ORDER BY ?position ?authorLabel
